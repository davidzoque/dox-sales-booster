msgstr "Página de pago (checkout)"

#: admin/settings.php:424 elementor/widgets.php:221
msgid "Free shipping amount"
msgstr "Monto para envío gratis"

#: admin/settings.php:427
msgid "Amount source"
msgstr "Fuente del monto"

#: admin/settings.php:429
msgid "Custom amount (set here)"
msgstr "Monto propio (configurado aquí)"

#: admin/settings.php:430
msgid "WooCommerce \"Free shipping\" method (minimum order)"
msgstr "Método \"Envío gratuito\" de WooCommerce (pedido mínimo)"

#: admin/settings.php:432
msgid "With the WooCommerce source, the amount is read from the minimum order of the \"Free shipping\" method in the shipping zone that matches the customer. If that zone has no minimum amount set, the custom amount is used as a fallback."
msgstr "Con la fuente WooCommerce, el monto se lee del pedido mínimo del método \"Envío gratuito\" de la zona de envío del cliente. Si esa zona no tiene monto mínimo configurado, se usa el monto propio como respaldo."

#: admin/settings.php:437
msgid "Custom amount"
msgstr "Monto propio"

#: admin/settings.php:439
msgid "Numbers only, no currency symbol. E.g. 100"
msgstr "Solo números, sin símbolo de moneda. Ej: 100"

#: admin/settings.php:446
msgid "Ignore coupons (count the subtotal without discounts)"
msgstr "Ignorar cupones (contar el subtotal sin descuentos)"

